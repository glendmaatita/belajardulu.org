# ── Konfigurasi BelajarYuk ──
# Salin file ini menjadi `.env` lalu isi nilainya.

# Google OAuth Client ID (tipe: "Web application")
# Buat di: https://console.cloud.google.com/apis/credentials
# - Authorized JavaScript origins: http://localhost:5173  (dan domain produksimu)
# Dipakai BACKEND untuk verifikasi token:
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Dipakai FRONTEND (Vite) untuk tombol Sign-in — harus SAMA dengan di atas:
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Rahasia untuk menandatangani session cookie (ganti dengan string acak panjang)
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang

# Opsional
PORT=8787
# DB_PATH=./data/app.db
